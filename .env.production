# The production backend serves its API under the /api context-path
# (application-prod.yml: server.servlet.context-path), so this MUST end in /api.
#
# The authoritative value is set in the Vercel project's Environment Variables
# (Production scope). Vite gives an existing process.env var highest priority, so
# the Vercel value overrides this committed placeholder at build time; the loud
# placeholder below only surfaces if you run `vite build` without setting it.
VITE_API_BASE_URL=https://REPLACE_WITH_BACKEND_HOST/api
